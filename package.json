{
  "name": "ddooby-block",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase:check": "node --disable-warning=ExperimentalWarning scripts/supabase-check/rls-check.ts",
    "server:shared": "node --disable-warning=ExperimentalWarning scripts/server-shared/build.ts",
    "server:shared:check": "node --disable-warning=ExperimentalWarning scripts/server-shared/build.ts --check",
    "functions:check": "deno check --no-lock --config supabase/functions/set-nickname/deno.json supabase/functions/set-nickname/index.ts"
  },
  "dependencies": {
    "@capacitor/core": "~8.5.3",
    "@capacitor/preferences": "~8.0.1",
    "@supabase/supabase-js": "2.119.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "rolldown": "1.2.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
